{
  "expo": {
    "name": "TradeSI",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "optiscreen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.optiiq.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice queries to analyze stocks hands-free"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.optiiq.app",
      "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-image.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice queries to analyze stocks hands-free"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
